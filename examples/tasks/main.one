// A personal task list: the smallest example that needs sign-in. Everything here
// belongs to the person who made it, and nobody else can see it or change it.

namespace tasks {

	entity task {
		title  text     required
		done   boolean  = false
		owner  user     = me
	}

	command task::create {
		by anyone signed in
	}

	command task::complete {
		by owner
		require !done  "that task is already done"
		done = true
	}

	command task::delete {
		by owner
	}

	view list per user {
		each task where owner == me {
			order by done  created_at descending
			title  done
		}
	}

	screen "Tasks" / {
		table list {
			title
			done
			complete  delete
		}
		form task::create {
			title
		}
	}

} // namespace tasks
