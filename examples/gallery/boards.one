// Boards: a room's pieces as cards in a column for each stage, moved along the
// room's steps, found, tinted by condition, picked by milestone, and dragged into
// order within a column. And a wall: the same pieces placed anywhere, dragged and
// resized, shown instead of the board while the room says so.

namespace gallery at / {

	screen "Boards" /rooms/:room/boards {
		board room_page.pieces by stage over room_page.stages link /rooms/:room/pieces/:piece {
			move piece::move along room_page.steps
			search title labels
			reorder position
			tint by condition
			track milestone over room_page.milestones {
				due "Opens"
			}
			title
			number  labels  assignees
		}
	}

	// A pipeline: each piece in a lane for its kind, as its labels say, along the stages
	// its kind goes through.
	screen "Pipeline" /rooms/:room/pipeline {
		pipeline room_page.pieces by stage over room_page.stages link /rooms/:room/pieces/:piece {
			lanes by labels
			path by kinds
			title
			number  condition
		}
	}

	screen "Wall" /rooms/:room/wall {
		board room_page.pieces by stage over room_page.stages link /rooms/:room/pieces/:piece when room_page.look == look::board {
			move piece::move along room_page.steps
			title
			number
		}
		canvas room_page.pieces by stage over room_page.stages link /rooms/:room/pieces/:piece when room_page.look == look::wall {
			place piece::place
			grid 160 from 40 80
			title
			number  condition
		}
	}

} // namespace gallery
