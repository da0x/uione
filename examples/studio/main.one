// A studio: posters kept on the machine the app runs on, for one person, laid out as
// a drawing app lays out its work. The smallest example that keeps its data at home
// (decision 0015), and so the one that undoes and redoes (decision 0018); a poster
// picked from the list is what the toolbar's buttons act on (decision 0017).

import one

project studio {
	one      "0.18.0"
	storage  local
	target   desktop web terminal
}

namespace studio at / {

	entity poster {
		title       text
		color       enum    ink | paper | sky = color::paper
		views       number  = 0
		width       number  = 1600
		height      number  = 900
		// Whether its pictures' colors are matched, so they look like one picture.
		matched     number  = 0
		preview     file
	}

	// What a poster is made of: pictures and words, lowest first. Around a picture is
	// nothing, its edges drawn out or its edge color to the poster's edges, a blend of
	// it into the rest, or it melted into what's under it; its corners are square, or
	// trimmed round.
	entity layer {
		poster   poster  required
		depth    number  = 0
		picture  file
		picture_width   number  = 0
		picture_height  number  = 0
		crop_x   number  = 0
		crop_y   number  = 0
		crop_w   number  = 1
		crop_h   number  = 1
		around   enum    clear | edges | color | blend | harmonize = around::clear
		corners  number  = 0
		words    text
		size     number  = 64
		weight   number  = 400
		x        number  = 0
		y        number  = 0
		w        number  = 400
		h        number  = 300
	}

	// A poster's notes, written as a page: each block a title, a heading, a paragraph,
	// a quote or an equation, aligned as it's written.
	entity passage {
		poster    poster  required
		kind      enum    title | subtitle | heading | text | quote | math = kind::text
		words     text
		align     enum    left | center | right = align::left
		position  number  = 0
	}

	command passage::create
	command passage::delete
	command passage::write {
		changes words kind
	}
	command passage::style {
		changes kind align
	}

	command poster::create
	command poster::update
	command poster::delete

	// A small picture of it, kept as it changes, which undo never takes back.
	command poster::preview {
		changes preview
		apart from undo
	}

	command layer::create
	command layer::delete
	// A picture's own size filled in, for one kept before its size was.
	command layer::update
	command layer::place {
		changes x y w h
		require w > 0 && h > 0  "a layer has a size"
	}

	command layer::crop {
		changes crop_x crop_y crop_w crop_h x y w h
		require crop_w > 0 && crop_h > 0  "a crop keeps some of the picture"
	}

	command layer::write {
		changes words size weight x y w h
		require size > 0  "words have a size"
	}

	command layer::arrange {
		changes around corners
	}

	// Opened once more: counted, but never a step undo takes back.
	command poster::view {
		changes views
		apart from undo
		views = views + 1
	}

	view posters {
		each poster {
			order by created_at descending
			title  color  views  preview  width  height
			first_layer = first(layer where layer.poster == poster.id).id
		}
	}

	view poster_page per poster {
		title  color  width  height  matched
		layers = each layer in poster {
			order by depth
			picture  crop_x  crop_y  crop_w  crop_h  around  corners  words  size  weight  depth  x  y  w  h
		}
	}

	view notes_page per poster {
		title
		passages = each passage in poster {
			order by position
			kind  words  align  position
		}
	}

	screen "Studio" / {
		layout workspace
		pick poster from posters
		bar {
			undo "Undo" icon undo key ctrl+z
			redo "Redo" icon redo key ctrl+y key ctrl+shift+z
			text "Posters"
			link /gallery "Gallery" icon gallery key g
		}
		toolbar {
			group "Poster" {
				poster::create "New" icon add key ctrl+n { width = screen.width  height = screen.height } then open /posters/:poster
				poster::delete "Delete" icon delete key delete
			}
			group "Color" small {
				poster::update "Ink" { color = color::ink }
				poster::update "Paper" { color = color::paper }
				poster::update "Sky" { color = color::sky }
			}
			group "View" small at end {
				toggle colors "Colors" icon color key c
				full screen "Full screen" icon fullscreen key f11
			}
		}
		main {
			table posters {
				picture preview fit
				title
				empty "Make a poster, and it's listed here."
			}
		}
		side when colors {
			// The picked poster as it looks, from the preview it keeps.
			picture poster.preview fit when poster != none
			text "{poster.title}, in {poster.color}" when poster != none
		}
		status {
			text "Picked {poster.title}" when poster != none
			messages
		}
	}

	// Straight into work: the newest poster with nothing on it yet, as big as this
	// screen, or a new one.
	screen "New poster" /new {
		on open open /posters/:poster for posters where poster.first_layer == none && poster.width == screen.width && poster.height == screen.height
		on open poster::create { width = screen.width  height = screen.height } then open /posters/:poster
	}

	// Every poster as it looks, from the preview it keeps of itself.
	screen "Gallery" /gallery {
		link / "Posters" icon gallery key escape
		link /new "New poster" icon add key n
		cards posters link /posters/:poster {
			picture preview fit
			title
		}
	}

	screen "Poster" /posters/:poster {
		layout workspace
		pick layer from poster_page.layers
		bar {
			link / "Posters" icon gallery key escape
			text "{poster_page.title}"
		}
		// Each visit counted, as the gallery shows.
		on open poster::view
		toolbar {
			group "Insert" {
				paste "Paste" icon paste key ctrl+v
				add words "Text" icon text key t
				screenshot "Screenshot" icon screenshot
			}
			// Bold drawn pressed while the picked words are, and taking it away then.
			group "Words" small when layer.words != none {
				layer::write "Bold" icon bold { weight = 400 } on when layer.weight >= 700
				layer::write "Bold" icon bold { weight = 700 } when layer.weight < 700
			}
			group "Margins" small when layer.picture != none {
				layer::arrange "Clear" icon clear { around = around::clear }
				layer::arrange "Edges" icon edges { around = around::edges }
				layer::arrange "Edge color" icon color { around = around::color }
				layer::arrange "Blend" icon blend { around = around::blend }
				layer::arrange "Harmonize" icon harmonize { around = around::harmonize }
			}
			group "Corners" small when layer.picture != none {
				layer::arrange "Square" icon square { corners = 0 }
				layer::arrange "Rounded" icon rounded { corners = 0.06 }
			}
			group "Look" small {
				poster::update "Match colors" icon magic { matched = 0 } on when poster_page.matched == 1 when poster_page.matched == 1
				poster::update "Match colors" icon magic { matched = 1 } when poster_page.matched != 1
			}
			group "Picture" {
				copy poster_page as picture "Copy" icon copy key ctrl+shift+c
				save poster_page as picture "Save" icon save key ctrl+s
			}
		}
		main {
			collage poster_page.layers size width height {
				add layer::create
				place layer::place
				crop layer::crop
				write layer::write
				delete layer::delete
				snap to edges
				match colors when poster_page.matched == 1
				paste
				keep preview poster::preview into preview 480 wide
				empty "Add a picture or some words to start"
				over layer {
					crop "Crop" icon crop key c
					edit words "Edit" icon edit key enter
					copy layer as picture "Copy" icon copy
					layer::delete "Delete" icon delete key delete
				}
			}
		}
		status {
			messages
		}
	}

	// A poster's notes, written on a sheet of paper; the toolbar sets the block the
	// caret is in.
	screen "Notes" /posters/:poster/notes {
		layout workspace
		pick passage from notes_page.passages
		bar {
			link / "Posters" icon gallery key escape
			text "{notes_page.title}"
			toggle reading "Read" icon eye
		}
		toolbar {
			group "Style" {
				passage::style "Title" icon title { kind = kind::title }
				passage::style "Heading" icon heading { kind = kind::heading }
				passage::style "Text" icon text { kind = kind::text }
				passage::style "Quote" icon quote { kind = kind::quote }
			}
			group "Align" small rows of 3 {
				passage::style "Left" icon align_left { align = align::left }
				passage::style "Center" icon align_center { align = align::center }
				passage::style "Right" icon align_right { align = align::right }
			}
			group "Insert" {
				insert "Equation" icon equation { kind = kind::math  align = align::center }
			}
			// The reader's own: how large it is, one page or two, and warm paper.
			group "Read" small {
				smaller "Smaller" icon smaller
				larger "Larger" icon larger
				toggle spread "Two pages" icon spread
				toggle coffee "Coffee" icon coffee
			}
		}
		main {
			paper notes_page.passages {
				write passage::write
				add passage::create
				delete passage::delete
				empty "Title"
				outline
				warm when coffee
				side by side when spread
				read only when reading
			}
		}
	}

}  // namespace studio
