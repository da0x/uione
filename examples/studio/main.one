// A studio: posters kept on the machine the app runs on, for one person, laid out as
// a drawing app lays out its work. The smallest example that keeps its data at home
// (decision 0015), and so the one that undoes and redoes (decision 0018); a poster
// picked from the list is what the toolbar's buttons act on (decision 0017).

import one

project studio {
	one      "0.18.0"
	storage  local
	target   desktop web terminal
}

namespace studio at / {

	entity poster {
		title       text
		color       enum    ink | paper | sky = color::paper
		views       number  = 0
		width       number  = 1600
		height      number  = 900
		background  enum    fit | fill | stretch | center = background::fill
		around      enum    edges | color = around::edges
		slide_x     number  = 0.5
		slide_y     number  = 0.5
		preview     file
	}

	// What a poster is made of: pictures and words, lowest first.
	entity layer {
		poster   poster  required
		depth    number  = 0
		picture  file
		picture_width   number  = 0
		picture_height  number  = 0
		crop_x   number  = 0
		crop_y   number  = 0
		crop_w   number  = 1
		crop_h   number  = 1
		words    text
		size     number  = 64
		x        number  = 0
		y        number  = 0
		w        number  = 400
		h        number  = 300
	}

	command poster::create
	command poster::update
	command poster::delete

	// A small picture of it, kept as it changes, which undo never takes back.
	command poster::preview {
		changes preview
		apart from undo
	}

	command poster::slide {
		changes slide_x slide_y
		require slide_x >= 0 && slide_x <= 1 && slide_y >= 0 && slide_y <= 1  "a slide is from 0 to 1"
	}

	command layer::create
	command layer::delete
	// A picture's own size filled in, for one kept before its size was.
	command layer::update
	command layer::place {
		changes x y w h
		require w > 0 && h > 0  "a layer has a size"
	}

	command layer::crop {
		changes crop_x crop_y crop_w crop_h x y w h
		require crop_w > 0 && crop_h > 0  "a crop keeps some of the picture"
	}

	command layer::write {
		changes words size x y w h
		require size > 0  "words have a size"
	}

	// Opened once more: counted, but never a step undo takes back.
	command poster::view {
		changes views
		apart from undo
		views = views + 1
	}

	view posters {
		each poster {
			order by created_at descending
			title  color  views  preview  width  height
			first_layer = first(layer where layer.poster == poster.id).id
		}
	}

	view poster_page per poster {
		title  color  width  height  background  around  slide_x  slide_y
		layers = each layer in poster {
			order by depth
			picture  crop_x  crop_y  crop_w  crop_h  words  size  depth  x  y  w  h
		}
	}

	screen "Studio" / {
		layout workspace
		pick poster from posters
		bar {
			undo "Undo" icon undo key ctrl+z
			redo "Redo" icon redo key ctrl+y key ctrl+shift+z
			text "Posters"
			link /gallery "Gallery" icon gallery key g
		}
		toolbar {
			group "Poster" {
				poster::create "New" icon add key ctrl+n { width = screen.width  height = screen.height } then open /posters/:poster
				poster::delete "Delete" icon delete key delete
			}
			group "Color" small {
				poster::update "Ink" { color = color::ink }
				poster::update "Paper" { color = color::paper }
				poster::update "Sky" { color = color::sky }
			}
			group "View" small at end {
				toggle colors "Colors" icon color key c
				full screen "Full screen" icon fullscreen key f11
			}
		}
		main {
			table posters {
				picture preview fit
				title
				empty "Make a poster, and it's listed here."
			}
		}
		side when colors {
			text "{poster.title}, in {poster.color}" when poster != none
		}
		status {
			text "Picked {poster.title}" when poster != none
			messages
		}
	}

	// Straight into work: the newest poster with nothing on it yet, as big as this
	// screen, or a new one.
	screen "New poster" /new {
		on open open /posters/:poster for posters where poster.first_layer == none && poster.width == screen.width && poster.height == screen.height
		on open poster::create { width = screen.width  height = screen.height } then open /posters/:poster
	}

	// Every poster as it looks, from the preview it keeps of itself.
	screen "Gallery" /gallery {
		link / "Posters" icon gallery key escape
		link /new "New poster" icon add key n
		cards posters link /posters/:poster {
			picture preview fit
			title
		}
	}

	screen "Poster" /posters/:poster {
		layout workspace
		pick layer from poster_page.layers
		bar {
			link / "Posters" icon gallery key escape
			text "{poster_page.title}"
			poster::view "Counted" on when poster_page.title != none
		}
		toolbar {
			group "Insert" {
				paste "Paste" icon paste
				add words "Text" icon text key t
				screenshot "Screenshot" icon screenshot
			}
			group "Picture" {
				copy poster_page as picture "Copy" icon copy key ctrl+shift+c
				save poster_page as picture "Save" icon save key ctrl+s
			}
		}
		main {
			collage poster_page.layers size width height {
				add layer::create
				place layer::place
				crop layer::crop
				write layer::write
				delete layer::delete
				slide poster::slide
				snap to edges
				paste
				keep preview poster::preview into preview 480 wide
				empty "Add a picture or some words to start"
				over layer {
					crop "Crop" icon crop key c
					edit words "Edit" icon edit key enter
					copy layer as picture "Copy" icon copy
					layer::delete "Delete" icon delete key delete
				}
			}
		}
		status {
			messages
		}
	}

}  // namespace studio
