# Compiles the desktop and terminal apps one build writes, against this checkout's
# libraries, with warnings as errors: the site's and the gallery's, which name both
# targets, the gallery using everything a screen can say, and the tracker example's,
# built from a copy given a project block that names them. Needs
# what desktop/ and terminal/ are built with, and a g++ with C++26.

set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
one=${ONE:-$here/compiler/build/one}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

"$one" build "$here/site" --out "$work/site" >/dev/null
mkdir -p "$work/tracker-source"
cp "$here"/examples/tracker/*.one "$work/tracker-source/"
{ printf 'import one\n\nproject tracker {\n\ttarget web desktop terminal\n\tsignin google\n}\n\n'; cat "$here/examples/tracker/main.one"; } > "$work/tracker-source/main.one"
"$one" build "$work/tracker-source" --out "$work/tracker" >/dev/null
"$one" build "$here/examples/gallery" --out "$work/gallery" >/dev/null
"$one" build "$here/examples/print_shop" --out "$work/print_shop" >/dev/null

# The libraries are compiled once for each target, the other apps' from the cache.
launcher=""
command -v ccache >/dev/null && launcher=-DCMAKE_CXX_COMPILER_LAUNCHER=ccache
for app in site tracker gallery print_shop; do
	for target in desktop terminal; do
		UIONE="$here" cmake -S "$work/$app/$target" -B "$work/$app/$target/out" -DCMAKE_CXX_FLAGS="-Wall -Wextra -Werror" $launcher >/dev/null
		# Built again where the compiler itself crashed, as g++ now and then does, but
		# never past an error in what it compiled.
		attempt=1
		until cmake --build "$work/$app/$target/out" --parallel 8 > "$work/build.log" 2>&1; do
			if ! grep -q "internal compiler error" "$work/build.log" || [ $attempt -ge 4 ]; then
				cat "$work/build.log" >&2
				exit 1
			fi
			attempt=$((attempt + 1))
		done
		echo "ok: $app's $target app compiles"
	done
done
