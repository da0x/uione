# Runs the gallery, examples/gallery, which draws every control uione has, in each of
# its apps at once, on this machine: the Firebase emulators, its Go backend on port
# 8081, the web app through Vite, and the desktop and terminal apps, all built from
# this checkout. Someone is signed in already, with a room of pieces to look at, so
# every page has something on it. Ctrl-C, or quitting the terminal app, stops them;
# the emulators keep running for the next start, until tools/emulators/run stop.
#
#   tools/gallery                    the web app and the desktop app
#   tools/gallery terminal           the terminal app here, the others beside it
#   tools/gallery web desktop        only those
#
# Each app is built from the gallery as it is now, so a change to it, or to a
# toolkit, is seen by running this again.

set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
apps=${*:-web desktop}
for app in $apps; do
	case $app in web | desktop | terminal) ;; *) echo "tools/gallery: $app isn't an app; say web, desktop or terminal" >&2 && exit 2 ;; esac
done
wants() { case " $apps " in *" $1 "*) return 0 ;; esac; return 1; }

work=${XDG_CACHE_HOME:-$HOME/.cache}/uione-gallery
mkdir -p "$work"
one=compiler/build/one
test -x $one || make -C compiler
tools/emulators/run >/dev/null
$one build examples/gallery --out "$work/build" >/dev/null
node tools/emulators/rules.mjs "$work/build/firestore.rules" >/dev/null
(cd "$work/build/api" && go mod tidy 2>/dev/null && go build -o ../../gallery-api .)

project=demo-uione
FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199 \
	GOOGLE_CLOUD_PROJECT=$project PORT=8081 "$work/gallery-api" >"$work/api.log" 2>&1 &
running=$!
stop() { kill $running 2>/dev/null || true; }
trap stop EXIT INT TERM
until curl -s -o /dev/null http://localhost:8081/; do sleep 0.2; done

# Someone signed in, Ada, by the auth emulator, with a room of the gallery's, kept
# where only these apps read it, never in your own ~/.config.
signed=$(curl -s -X POST -H 'Content-Type: application/json' "http://localhost:9099/identitytoolkit.googleapis.com/v1/accounts:signInWithIdp?key=any" \
	-d '{"postBody":"id_token={\"sub\":\"ada-gallery\",\"email\":\"ada@example.com\",\"email_verified\":true,\"name\":\"Ada Lovelace\"}&providerId=google.com","requestUri":"http://localhost","returnSecureToken":true}')
token=$(printf '%s' "$signed" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).idToken))')
refresh=$(printf '%s' "$signed" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).refreshToken))')
command() { curl -s -o /dev/null -X POST -H "Authorization: Bearer $token" -H 'Content-Type: application/json' "http://localhost:8081/api/gallery/$1" -d "$2"; }
command room/create '{"slug":"north","name":"North room","summary":"Where the gallery shows **every control**."}'
command milestone/create '{"room":"north","title":"Spring show","due":"2026-11-02"}'
for piece in '"title":"Harbor at dusk","condition":"good","size":"large","light":40,"labels":["oil","coast"]' \
	'"title":"Cracked vase","condition":"damaged","size":"small","light":15' \
	'"title":"Study in blue","condition":"mint","size":"medium","light":70,"labels":["ink"]'; do
	command piece/create "{\"room\":\"north\",$piece}"
done
config=$work/config
mkdir -p "$config/gallery"
(umask 077 && printf '{"server":"http://localhost:8081","refresh_token":"%s"}\n' "$refresh" >"$config/gallery/credentials")
native() {
	cmake -S "$work/build/$1" -B "$work/build/$1/out" -DCMAKE_BUILD_TYPE=Debug >/dev/null
	cmake --build "$work/build/$1/out" --parallel 4 >/dev/null
	env XDG_CONFIG_HOME="$config" ONE_SERVER=http://localhost:8081 ONE_FIREBASE_PROJECT=$project ONE_FIRESTORE_HOST=localhost:8080 \
		ONE_AUTH_HOST=localhost:9099 "$work/build/$1/out/gallery" /rooms/north
}

if wants web; then
	# The web app reads @uione/react and @uione/radix from this checkout, as built now.
	yarn install --silent
	yarn workspace @uione/react build >/dev/null
	yarn workspace @uione/radix build >/dev/null
	ln -sfn "$root/node_modules" "$work/build/web/node_modules"
	(cd "$work/build/web" && exec node_modules/.bin/vite --port 5180 --strictPort >"$work/web.log" 2>&1) &
	running="$running $!"
	echo "web: http://localhost:5180/rooms/north"
fi
if wants desktop; then
	UIONE="$root" native desktop >"$work/desktop.log" 2>&1 &
	running="$running $!"
	echo "desktop: opening its window"
fi
if wants terminal; then
	UIONE="$root" native terminal
else
	echo "Ctrl-C stops them."
	wait
fi
