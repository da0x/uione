/*
 * The grammar of uione: what a .one file can say, written in the EBNF that the
 * XML specification uses. A rule is `name ::= what it is`; "quoted" text is
 * written as it is; | separates choices; ? is optional, * is any number and + is
 * one or more.
 *
 * It's the specification the hand-written parser in compiler/language/ is held
 * to. compiler/tests/grammar_tests.cpp checks it both ways: every program made
 * from these rules parses, and every .one file in the repository fits them.
 * editors/test.mjs checks that both editor grammars know the same words.
 *
 * The words in capitals are the pieces a file is read in:
 *
 *   NAME     a word of letters, digits and _, starting with a letter or _
 *   STRING   text in double quotes, on one line, where \" and \\ stand for " and \
 *            each string alone on the lines right after one that ends its line
 *            goes on with it, joined by a space
 *   NUMBER   digits, with a fractional part if it has one: 14, 2.5
 *   COLOR    # and six hex digits: #2457d6
 *   WHOLE    digits alone, a number with no fractional part: 50
 *   ROUTE    a page's address: /, /shelf, /docs/:page, /code/:file*, whose last
 *            parameter may end in * to take the rest of the address
 *   ANCHOR   a place on a page: #waitlist
 *   PATTERN  the rest of the line, up to a { if there is one, for a format
 *   NEWLINE  the end of a line; blank lines and comments count as one
 *   END      the end of a line, or nothing just before a }, which is what lets
 *            a short block sit on one line: if done { return true }
 *   EOF      the end of the file
 *
 * Comments are // to the end of the line, or run from slash-star to star-slash.
 *
 * Lines are indented with tabs, never spaces (decision 0011). Indentation carries
 * no meaning to the grammar; the lexer refuses a line indented with spaces.
 *
 * Some places name exactly the words the language knows, like a field's type or
 * a project's settings, where the parser itself accepts any NAME and leaves the
 * checker to say it isn't one. This grammar is the language, so it names them.
 */

file           ::= declaration* EOF

declaration    ::= import | project | namespace | format | enum_type | entity | command | view | role | define_role | extend_role | define_service | define_theme | define_workflow | define_agent
                 | function | screen | notify | picker | webhook | backend | once | signin | settings | header | footer

/* import one: a library a file uses, like uione's own, which says what a project may say */
import         ::= "import" NAME END
/* settings project { ... }: what a block of settings may say, declared in a library */
settings       ::= "settings" NAME "{" NEWLINE? field* "}" END

/* project */

project        ::= "project" NAME "{" NEWLINE? (setting | environment | at_most)* "}" END
setting        ::= setting_name (STRING | qualified+) END   /* a list may say several, target web desktop */
                 | "redirect" STRING STRING END
                 | "domain" STRING STRING END     /* a second domain, like www, sends people to the first */
setting_name   ::= "domain" | "firebase" | "region" | "ui" | "signin" | "target" | "icon" | "layout" | "serve"
                 | "title" | "one" | "extends" | "analytics" | "theme" | "appearance" | "accessibility" | "storage"

/* A place the project runs: its own domain, Firebase project and region, which take
 * the place of the shared ones. `one build --for staging` builds for it. */
environment    ::= "environment" NAME "{" NEWLINE? place* "}" END
place          ::= ("domain" | "firebase" | "region") STRING END
                 | "domain" STRING STRING END

/* namespace */

namespace      ::= "namespace" NAME ("at" ROUTE)? "{" NEWLINE? declaration* "}" END

/* format */

format         ::= "format" NAME PATTERN ("{" NEWLINE? example* "}")? END
example        ::= "example" PATTERN END

/* entity */

/* entity comment history of issue: a comment's changes are kept in its issue's history */
/* entity invitation invites member: when someone signs in with its email, they become one */
entity         ::= "entity" NAME ("invites" NAME)? ("gives" qualified "to" "each" qualified)? ("history" ("of" NAME)?)? "{" NEWLINE? (entity_readers | at_most | field)* "}" END
entity_readers ::= "readers" NAME END
                 | "audit" "kept" NUMBER ("day" | "days" | "week" | "weeks" | "month" | "months" | "year" | "years") END
                 | "public" "when" condition END
/* who may read the views of it, and of what's within it, unless a view says its own */
field          ::= NAME (enum | type) rule* STRING? ("=" expression)? END
/* number  serial  key  "#": what every screen calls it, unless one says its own */
enum           ::= "enum" (choice ("|" choice)* | "{" NEWLINE? (choice+ END)* "}")
choice         ::= NAME STRING?
enum_type      ::= "enum" NAME "{" NEWLINE? (choice+ END)* "}" END
type           ::= "text" | "markdown" | "email" | "slug" | "date" | "number" | serial | "boolean" | "user" | "file" | "data" | list | qualified
list           ::= "list" "of" ("text" | "user" | "permission" | qualified)
serial         ::= "serial" ("per" NAME)?
rule           ::= "required" | "unique" | "key" | "searchable" | "after" NAME
                 | "from" "-"? NUMBER "to" "-"? NUMBER ( "by" NUMBER )?

/* header: what's beside the site's name on every page; a badge shows a value of a
 * view, like what's new to the person reading, when it's more than none */

header         ::= "header" "{" NEWLINE? (badge | navigation)* "}" END
                 | "header" ROUTE screen_block END
/* header /:project { … }: items above every screen whose address goes on from that path */
badge          ::= "badge" NAME "." NAME END
navigation     ::= "navigation" qualified+ END

/* footer: what's at the foot of every page, in one line or in columns of sections,
 * drawn with a screen's text, links and sections */

footer         ::= "footer" ("bar" | "columns")? screen_block END

/* backend */

backend        ::= "backend" NAME END

/* once */

once           ::= "once" STRING "{" NEWLINE? once_step* "}" END
once_step      ::= "each" NAME ("where" condition)? block END
/* done each time someone opens the app signed in, as them, me.email the email their
   sign-in vouches for */
signin         ::= "on" "signin" "{" NEWLINE? (once_step | "delete" "each" NAME ("where" condition)? END)* "}" END

/* command */

command        ::= "command" qualified ("{" NEWLINE? (at_most | "apart" "from" "undo" END | statement)* "}")? END
/* apart from undo: kept, but never a step undo takes back, like a preview drawn again */
/* at most 30 per hour: how often each person or service may run a command; on an
 * entity, how many of it each may make in a day; in a project, what every command
 * and entity allows unless it says its own */
at_most        ::= "at" "most" NUMBER "per" ("second" | "minute" | "hour" | "day") END
block          ::= "{" NEWLINE? statement* "}"
statement      ::= ( "require" (expression STRING | STRING "{" NEWLINE? (expression END)+ "}")
                   | "permission" qualified
                   | "by" ("anyone" ("signed" "in")? | "owner")
                   | "clear" NAME+
                   | "changes" NAME+
                   | "return" expression
                   | if
                   | dispatch
                   | stripe
                   | list_change
                   | "input" NAME qualified
                   /* other: a row of the command's own kind, its fields other.pair */
                   | "each" "other"? NAME "where" condition block
                   | postfix "=" expression ) END
/* dispatch: another command run in the same step, its body too: an update or a
 * delete says which with id = ..., or acts on the row of an each over its entity. */
dispatch       ::= "dispatch" NAME "::" NAME ("{" NEWLINE? (((NAME "=" postfix)+ | list_change) END)* "}")?
/* stripe: a call to Stripe for the customer the command is on, like an organization:
 * checkout, the Customer Portal, a change of price or quantity, or cancel, at its
 * period's end or now. */
stripe         ::= "stripe" ("checkout" | "portal" | "change" | "cancel" "now"?) ("{" NEWLINE? ((NAME "=" postfix)+ END)* "}")?
list_change    ::= "add" postfix "to" NAME | "remove" postfix "from" NAME
if             ::= "if" expression block ("else" (if | block))?

/* view */

/* a value can count the rows of the view's own list that pass, compared with its
 * other values: unread = count(changes where created_at > seen) */
view           ::= "view" NAME "public"? "{" NEWLINE? ("readers" NAME END)* view_line* "}" END
                 | "view" NAME "public"? "per" NAME "public"? "{" NEWLINE? ("readers" NAME END)* (view_line | view_fields)* "}" END
view_line      ::= (NAME "=")? each
                 | "readers" NAME ("." NAME)+ END
                 | "public" "when" condition END
                 | NAME "=" expression END
view_fields    ::= (NAME ("." NAME)*)+ END
/* number  title  stage.title: in a view per something, its fields bare, and what they point at */
each           ::= "each" ("change" "in")? postfix ("in" NAME)* ("where" condition)? ("{" NEWLINE? list_line* "}")? END
list_line      ::= "order" "by" order_key+ END
                 | "limit" WHOLE END
                 | row_line
order_key      ::= postfix ("ascending" | "descending")?
row_line       ::= (postfix+ | postfix* NAME "=" expression) END

/* role */

role           ::= "role" NAME qualified* ("{" NEWLINE? (qualified+ END)* "}")? END
/* define role: a role each project starts with, kept as the language's role
 * records, given to people by member records, with the commands it allows, one
 * a line, and the roles it holds in each of what's within, like an organization's
 * owner maintaining each of its projects. */
define_role    ::= "define" "role" NAME STRING "in" NAME ("for" "services")? "{" NEWLINE? ((qualified | "holds" qualified "in" "each" qualified | "keep" "at" "least" NUMBER NAME) END)* "}" END
extend_role    ::= "extend" "role" qualified "{" NEWLINE? (qualified END)* "}" END
/* define workflow: the rules an entity moves by, along a field pointing at its
 * stages: the stage's field listing the roles that work it, the entity of steps
 * between them, and how long a claim lasts. Along a field of choices, its stages
 * are written in it instead: the roles that work each, and the steps between
 * them, taken by who works the first unless a step names its own; how arrivals
 * in a stage are told, where its work is done, and the list of what it waits on
 * before it leaves its first stage. */
define_workflow ::= "define" "workflow" NAME "by" NAME "{" NEWLINE? workflow_line* "}" END
workflow_line  ::= ( "worked" "by" NAME
                   | "steps" NAME
                   | NAME "worked" "by" NAME ("," NAME)*
                   | NAME "-" ">" NAME ("by" NAME ("," NAME)*)?
                   | NAME "notify" NAME ("," NAME)*
                   | "done" "at" NAME
                   | "depends" "on" NAME
                   | "while" expression
                   | "lease" WHOLE ("minute" | "minutes" | "hour" | "hours") ) END
/* define agent: a program working, as a role for services, the stages it names:
 * what it runs when a record arrives there, and where the record goes when the
 * program succeeds and when it fails. */
define_agent   ::= "define" "agent" NAME "for" NAME "{" NEWLINE? agent_line* "}" END
agent_line     ::= "on" NAME "in" NAME "run" STRING "then" NAME ("else" NAME)? END
/* define theme: how a site looks, as a color for each role, light and dark, its
 * fonts, corners and depth; from another, it changes only what it says. */
define_theme   ::= "define" "theme" NAME STRING ("from" NAME)? "{" NEWLINE? theme_line* "}" END
theme_line     ::= ( NAME COLOR ("dark" COLOR)?
                   /* heading "Fraunces" from "fonts/Fraunces.ttf": a font the app brings, from a file beside this one */
                   | ("text" | "heading" | "document") STRING ("from" STRING)?
                   | "code" STRING ("ground" COLOR ("dark" COLOR)?)?
                   | "corners" WHOLE
                   | "depth" ("flat" | "raised") ) END
/* define service: a system that runs commands, not a person, like GitHub telling
 * each project about commits; a webhook runs as one. */
define_service ::= "define" "service" NAME STRING ("in" NAME)? "{" NEWLINE? (qualified END)* "}" END

/* function */

function       ::= "function" NAME "(" (NAME ("," NAME)*)? ")" block END

/* screen */

screen         ::= "screen" (STRING | NAME)? ROUTE (NEWLINE? ROUTE)* ("landing" NAME)? screen_body END
/* an untitled screen shows the site's title; each address is the same screen */
screen_body    ::= "{" NEWLINE? (screen_place | screen_item)* "}"
screen_place   ::= "under" ROUTE STRING END
                 | "layout" NAME END
/* under /:project/boards/:board "{issue_page.board.title}": the page above it, though its
   address doesn't say so; layout two_columns: how its regions are laid out, or layout
   workspace: filling the window, with a bar, a toolbar, tools down its left, main, side and a status line */
/* landing waveform | studio | aurora | grid | relay | constellation | folio: a front page drawn in one of uione's designs */
screen_block   ::= "{" NEWLINE? screen_item* "}"
given          ::= "{" NEWLINE? ((NAME "=" expression)+ END)* "}"
/* opacity from 0 to 1: on a screen's button, any value along a slider, its command run as it's let go;
   fill any color: any color, chosen with a color picker */
button_given   ::= "{" NEWLINE? ((NAME ("=" expression | "from" "-"? NUMBER "to" "-"? NUMBER ("by" NUMBER)? | "any" "color"))+ END)* "}"
collage_line   ::= ("place" qualified | "reshape" qualified | "group" qualified | "order" qualified | "add" qualified | "crop" qualified | "write" qualified | "delete" qualified
                  | "snap" "to" "edges" | "clear" | "match" "colors" "when" expression | "empty" STRING | "over" NAME screen_block
                  /* its objects held in layers, another list of its view, each naming its own by a field */
                  | "in" qualified "." NAME "by" NAME
                  /* a drag on it makes a layer as big as the drag, given these values, while the when holds;
                     by line, a line from where the drag began to where it ended, by hand what it went
                     through, and by points a path node by node, as a pen draws, each kept as a path's points;
                     by typing, words typed where it's pressed, made once they're kept;
                     with stroke from layer::paint: these as that command's buttons last gave them */
                  | "draw" qualified given? ("by" ("line" | "hand" | "points" | "typing"))? ("with" NAME+ "from" qualified)* ("when" expression)?
                  /* pictures dropped or pasted are made by add, in the layer's picture */
                  | "paste"
                  /* the fields playing its parts, each kept in the field named like it unless one of these says another */
                  | "at" NAME NAME ("size" NAME NAME)? | "size" NAME NAME | "stacked" "by" NAME
                  | "picture" NAME ("sized" NAME NAME)? | "cropped" "to" NAME NAME NAME NAME | "turned" NAME | "mirrored" NAME | "around" NAME | "rounded" NAME
                  | "words" NAME ("sized" NAME)? ("colored" NAME)? ("weighing" NAME)? ("slanted" NAME)?
                  /* a small picture of it, drawn once changes settle, sent to a command on what the view is per */
                  | "keep" "preview" qualified "into" NAME NUMBER "wide") END
paper_line     ::= ("write" qualified | "add" qualified | "delete" qualified | "empty" STRING
                  /* its title and headings listed beside it, the caret's section marked, each going there;
                     with when, only while it holds, as a drawer a toggle opens */
                  | "outline" ("when" expression)?
                  /* pictures pasted or dropped, made picture blocks by its add */
                  | "paste"
                  /* a bar across its top, as far along as it's been read */
                  | "progress"
                  /* set on warm paper, as under a reading lamp, while it holds, like a reader's toggle */
                  | "warm" "when" expression
                  /* its pages two at a time, side by side, while it holds, like a reader's toggle */
                  | "side" "by" "side" "when" expression
                  /* read, not written on, while it holds */
                  | "read" "only" "when" expression
                  /* a part, words, kind, align or position, then the field playing it: each is kept in the field
                     named like it unless one of these says another */
                  | NAME NAME) END
/* key ctrl+z: what runs a line too; any of ctrl, shift and alt, then a key, like f11 or delete */
key            ::= "key" (NAME | NUMBER) ("+" (NAME | NUMBER))*
screen_item    ::= ("hero" | "section") STRING ANCHOR? ("icon" NAME)? ("color" NAME)? ("as" "steps")? ("when" expression)? screen_block END
                 | "menu" screen_block END
                 | ("main" | "side" | "bar" | "toolbar" | "tools" | "status") ("when" expression)? screen_block END
                 /* a named part of a workspace's toolbar, its buttons tools */
                 | "group" STRING "small"? ("rows" "of" NUMBER)? ("at" "end")? ("when" expression)? screen_block END
                 /* a tool in a toolbar that opens its buttons, each a choice drawn with what it's for */
                 | "options" STRING ("icon" NAME)? ("when" expression)? screen_block END
                 /* a picture made of layers, as big as two of the view's values say */
                 | "collage" qualified "." NAME ("size" NAME NAME)? "{" NEWLINE? collage_line* "}" END
                 /* the screen's collage's layers as a list, topmost first, each hidden or shown, previewed, ordered and deleted */
                 | "layers" qualified "." NAME "{" NEWLINE? (("hide" | "order" | "rename" | "delete") qualified END)* "}" END
                 /* a list's rows as a sheet of paper, written on in place */
                 | "paper" qualified "." NAME "{" NEWLINE? paper_line* "}" END
                 /* a block made after the one the screen's paper has the caret in, given these values */
                 | "insert" STRING ("icon" NAME)? key* given? ("when" expression)? END
                 /* the reader's paper made larger or smaller, as zooming a book does, kept for them */
                 | ("larger" | "smaller") STRING ("icon" NAME)? key* ("when" expression)? END
                 /* what the screen's collage does: crops its picked picture, writes its picked words, adds words,
                    pastes what's on the clipboard, adds a screenshot or pictures chosen from the device's files, or copies
                    or saves it, or its picked layer, as a picture; paste, add pictures and add folder go into a paper or cards that say paste;
                    add folder takes every picture in a folder chosen and the folders in it, but hidden ones */
                 | ("crop" | "edit" "words" | "add" "words" | "add" "pictures" | "add" "folder" | "paste" | "screenshot" | "ungroup" | "group" "picked" | "raise" | "lower" | "zoom" ("in" | "out" | "to" "fit") | ("copy" | "save" | "cut") NAME "as" ("picture" | "svg")) STRING? ("icon" NAME)? key* ("when" expression)? END
                 /* what the screen does as it's opened, the first of its lines that applies: the first row of a
                    view's list the condition holds for opened, the row named by what it's of; or a command run */
                 | "on" "open" ("open" ROUTE "for" qualified ("." NAME)? ("where" expression)? ("when" expression)? END | screen_item)
                 /* the file a view's value, or a field of what's picked, holds, as wide as its place; alone,
                    the whole of a workspace's screen, its bars over it, zoomed and moved about as it's looked at */
                 | "picture" NAME "." NAME ("fit" | "fill")? "alone"? ("when" expression)? END
                 /* a row of a view's list the screen holds, picked with a click, read by its name */
                 | "pick" NAME "from" qualified ("." NAME)? END
                 /* something on or off, read by its name, like side when layers; or one of an
                    enum's choices, pressed one at a time, like when tool == tool::pen */
                 | "toggle" NAME ("::" NAME)? STRING? ("icon" NAME)? key* END
                 /* the page's last step taken back, or taken again, for a project kept on its machine */
                 | ("undo" | "redo") STRING? ("icon" NAME)? key* END
                 /* what was just done, or why a command was turned down */
                 | "messages" END
                 | "full" "screen" STRING? ("icon" NAME)? key* END
                 | "heading" screen_block END
                 | "subtitle" STRING END
                 /* the short line over a hero's or a section's title, and a front page's one sentence that stands for the site */
                 | "overline" STRING END
                 | "statement" STRING END
                 /* mosaic: their pictures set edge to edge, each filling its tile, every eight two blocks of three columns
                    by two rows as tall as a column is wide, a tall tile, a wide one and two small, the second block mirrored;
                    by: under a heading for each year, month or day of a date the list is ordered by first, newest first
                    when it's descending, a mosaic's tiles starting again under each */
                 | "cards" qualified ("." NAME)? "mosaic"? ("by" NAME ("year" | "month" | "day"))? ("link" ROUTE)? ("when" expression)? ("{" NEWLINE? cards_line* "}")? END
                 /* a run of numbers over time, or several side by side */
                 | "chart" qualified "." series ("when" expression)? END
                 | "charts" qualified ("when" expression)? "{" NEWLINE? (series END)* "}" END
                 /* records whose status changes, a tile each */
                 | "monitor" qualified "." NAME ("link" ROUTE)? ("when" expression)? "{" NEWLINE? monitor_line* "}" END
                 | "text" STRING ("when" condition)? END
                 | "code" STRING END
                 | "markdown" STRING ("as" "document")? END
                 /* previous or next: the same screen for the record before or after, in the list named, or with
                    none, in the list the record was opened from, else the first list whose rows open it */
                 | "link" (ROUTE | ANCHOR | "namespace" qualified | STRING | "build" "." ("release" | "source") | ("previous" | "next") ("in" qualified ("." NAME)?)?) STRING ("icon" NAME)? key* END
                 | "table" qualified ("." NAME)? ("by" NAME tabs_over?)? ("link" ROUTE)? ("when" expression)? ("{" NEWLINE? table_line* "}")? END
                 | "form" qualified+ STRING? "{" NEWLINE? form_line* "}" END
                 | "confirm" qualified STRING END
                 | "thread" qualified "." NAME END
                 | "timeline" qualified "." NAME STRING? ("link" ROUTE)? ("{" NEWLINE timeline_line* "}")? END
                 /* the years and months of the screen's cards under headings by the date, each with how many it
                    holds, the one in view marked; one chosen scrolls the cards to its heading */
                 | "timeline" qualified "." NAME "by" NAME END
                 | "copy" qualified STRING? END
                 | "themes" END
                 | "details" qualified "{" NEWLINE? (("tint" "by" NAME | column+) END)* "}" END
                 /* a box finding rows of several lists as it's typed in */
                 | "find" STRING "{" NEWLINE? find_line* "}" END
                 | ("grid" | "diagram") qualified "." NAME "by" NAME "and" NAME "over" qualified "." NAME ("{" NEWLINE? (postfix END)? "}")? END
                 | "component" NAME END
                 /* a button, and the form it opens, issue::update "Edit" form "Save" { title } */
                 /* layer::scale "2×" { by = 2 }: what it's sent; on when: drawn pressed; then open: what it made, opened */
                 | NAME ("::" NAME)+ ("along" qualified "." NAME | STRING? ("icon" NAME)? ("about" STRING)? key* button_given? ("on" "when" expression)? ("when" condition)?
                                    ("then" "open" ROUTE)? ("form" STRING? "{" NEWLINE? form_line* "}")?) END
                 | "board" qualified "." NAME "by" NAME ("over" qualified "." NAME)? ("link" ROUTE)? ("when" expression)? ("{" NEWLINE? board_line* "}")? END
                 /* a list's rows on the days a date of theirs says, a week side by side, or a month's grid while it
                    says; one picked with a click, and dragged to another day sent to move, its time of day kept */
                 | "calendar" qualified ("." NAME)? "by" NAME ("when" expression)? ("{" NEWLINE? calendar_line* "}")? END
                 /* a lane for each kind of card, each a row of its kind's stages, the one it's at highlighted */
                 | "pipeline" qualified "." NAME "by" NAME "over" qualified "." NAME ("link" ROUTE)? ("when" expression)? ("{" NEWLINE? pipeline_line* "}")? END
                 /* cards placed anywhere, dragged and resized, placed by a command once let go */
                 | "canvas" qualified "." NAME ("by" NAME ("over" qualified "." NAME)?)? ("link" ROUTE)? ("when" expression)? ("{" NEWLINE? canvas_line* "}")? END
pipeline_line  ::= (("lanes" | "path" | "status") "by" NAME | column+) END
canvas_line    ::= ("place" qualified | "at" NAME NAME ("size" NAME NAME)? | "size" NAME NAME | "kind" NAME | "grid" NUMBER ("from" NUMBER NUMBER)?
                    | "regions" "by" NAME | "move" qualified ("along" qualified "." NAME)? | "resize" qualified
                    | "paste" qualified "into" NAME | "picture" NAME | column+) END
cards_line     ::= ("tally" qualified "." NAME "by" NAME "and" NAME | "filter" STRING filter ("color" NAME)? | "picture" NAME ("fit" | "fill")?
                  /* pictures dropped, pasted or chosen, each a record made by add, its file in the picture,
                     its own size, upright, its file's name, bytes, date and camera each kept in the field named
                     like it: picture_width, picture_height, name, picture_bytes, picture_date, when its camera
                     says it was taken or else when its file last changed, and picture_camera, its make and model */
                  | "add" qualified | "paste"
                  | column+) END
series         ::= NAME ("." NAME)? STRING ("percent" | "bytes" | "rate")?
monitor_line   ::= ("title" field_path | "status" field_path | "since" field_path | "doing" field_path
                   | "progress" field_path "of" field_path | "seen" field_path NUMBER | "chart" series) END
field_path     ::= NAME ("." NAME)*
calendar_line  ::= ("month" "when" expression | "move" qualified | "tint" "by" NAME | column+) END
board_line     ::= ("move" qualified ("along" qualified "." NAME)? | "chime" "when" NAME "has" NAME | "status" "by" NAME | "tint" "by" NAME | "reorder" NAME | track | "search" (NAME ("." NAME)*)+ | NAME "::" NAME STRING? ("icon" NAME)? | column+) END
tabs_over      ::= "over" qualified "." NAME
condition      ::= expression | "{" NEWLINE? (expression END)+ "}"
column         ::= NAME ("." NAME)* STRING?
form_line      ::= ((NAME STRING?)+ | (NAME STRING?)* NAME STRING? "=" expression hint? | (NAME STRING?)* NAME STRING? hint) END
/* takes_reports "Reports" { hint "..." }: any field can say what it means, under it */
hint           ::= "{" NEWLINE? "hint" STRING END "}"

/* picker */

picker         ::= "picker" NAME "from" NAME END

/* webhook */

/* what's said whatever screen is open once a row's time comes: what it shows, its first line first, and
   buttons acting on the row, given values written out */
notify         ::= "notify" qualified ("." NAME)? "at" NAME "{" NEWLINE? notify_line* "}" END
notify_line    ::= (NAME "::" NAME STRING? given? | column+) END
webhook        ::= "webhook" NAME ROUTE ("as" NAME)? "{" NEWLINE? webhook_line* "}" END
webhook_line   ::= "for" NAME ("by" NAME)? END
                 | "on" NAME block END

/* expressions, loosest first */

expression     ::= conjunction ("||" conjunction)*
conjunction    ::= equality ("&&" equality)*
equality       ::= comparison (("==" | "!=" | "has") comparison)*
comparison     ::= sum (("<" | ">" | "<=" | ">=") sum)*
sum            ::= product (("+" | "-") product)*
product        ::= unary (("*" | "/" | "%") unary)*   /* a / alone between two values divides; % leaves what's over, as a clock counts */
unary          ::= ("!" | "-") unary | "was" postfix | postfix
postfix        ::= primary ("(" (argument ("," argument)*)? ")" | "." NAME)*
argument       ::= expression ("where" expression)?
primary        ::= STRING | time | NUMBER | built_in | qualified | "(" expression ")" | "[" NEWLINE? (expression NEWLINE? ("," NEWLINE? expression NEWLINE?)* ("," NEWLINE?)?)? "]"
                 | match
/* a value for each choice of an enum, one a line, and else for the rest */
match          ::= "match" NAME ("." NAME)* "{" NEWLINE? (NAME expression END)+ ("else" expression END)? "}"
/* the changes a condition holds for are new, reading other views as they were when the
   page opened, and on open runs a command once it opens with something new in it */
timeline_line  ::= "new" "when" expression END
                 | "on" "open" "dispatch" qualified END
/* a card's filter: a field and what it holds, or a time it's before or after, counted
   from when it's opened: updated_at > 7 days ago, due <= 2 weeks from now; in a
   command, a time is counted from when it runs: held_until = 10 minutes from now */
filter         ::= NAME "==" expression | NAME ("<" | ">" | "<=" | ">=") time
time           ::= NUMBER ("minute" | "minutes" | "hour" | "hours" | "day" | "days" | "week" | "weeks") ("ago" | "from" "now")
                 /* a day, a week from Monday or a month by the calendar where it's read, alone or at a time of
                    day on a 24-hour clock: due < tomorrow, remind_at = tomorrow at 9:00 */
                 | ("today" | "tomorrow" | "yesterday" | ("this" | "next" | "last") ("week" | "month")) ("at" CLOCK)?
built_in       ::= "now" | "me" | "none" | "true" | "false"
qualified      ::= NAME ("::" NAME)*

find_line      ::= qualified ("." NAME)? STRING ("link" ROUTE)? "by" NAME+ END
/* track milestone over board_page.milestones { due }: a list's records as cards in a
   row joined by arrows; picking one keeps the rows whose field is it. */
track          ::= "track" NAME "over" qualified "." NAME ("{" NEWLINE? (("hide" "when" "empty" | "picked" "last" | column+) END)* "}")?
table_line     ::= "by" NAME tabs_over? END
                 | NAME "::" NAME STRING? ("icon" NAME)? END
                 | "reorder" NAME "descending"? END
                 /* a small picture of a file each row holds, before its cells */
                 | "picture" NAME ("fit" | "fill")? END
                 | "hide" "when" "empty" END
                 | "empty" STRING END
                 | "download" STRING END
                 | "search" (NAME ("." NAME)*)+ END
                 | "sort" "by" NAME ("ascending" | "descending")? END
                 | "page" WHOLE END
                 | "only" filter END
                 | "tint" "by" NAME END
                 | track END
                 | column+ ("when" condition)? END
