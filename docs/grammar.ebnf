/*
 * The grammar of uione: what a .one file can say, written in the EBNF that the
 * XML specification uses. A rule is `name ::= what it is`; "quoted" text is
 * written as it is; | separates choices; ? is optional, * is any number and + is
 * one or more.
 *
 * It's the specification the hand-written parser in compiler/language/ is held
 * to. compiler/tests/grammar_tests.cpp checks it both ways: every program made
 * from these rules parses, and every .one file in the repository fits them.
 * editors/test.mjs checks that both editor grammars know the same words.
 *
 * The words in capitals are the pieces a file is read in:
 *
 *   NAME     a word of letters, digits and _, starting with a letter or _
 *   STRING   text in double quotes, on one line, where \" and \\ stand for " and \
 *   NUMBER   digits, with a fractional part if it has one: 14, 2.5
 *   WHOLE    digits alone, a number with no fractional part: 50
 *   ROUTE    a page's address: /, /shelf, /docs/:page, /code/:file*, whose last
 *            parameter may end in * to take the rest of the address
 *   ANCHOR   a place on a page: #waitlist
 *   PATTERN  the rest of the line, up to a { if there is one, for a format
 *   NEWLINE  the end of a line; blank lines and comments count as one
 *   END      the end of a line, or nothing just before a }, which is what lets
 *            a short block sit on one line: if done { return true }
 *   EOF      the end of the file
 *
 * Comments are // to the end of the line, or run from slash-star to star-slash.
 *
 * Lines are indented with tabs, never spaces (decision 0011). Indentation carries
 * no meaning to the grammar; the lexer refuses a line indented with spaces.
 *
 * Some places name exactly the words the language knows, like a field's type or
 * a project's settings, where the parser itself accepts any NAME and leaves the
 * checker to say it isn't one. This grammar is the language, so it names them.
 */

file           ::= declaration* EOF

declaration    ::= project | namespace | format | entity | command | view | role
                 | function | screen | picker | webhook | backend

/* project */

project        ::= "project" NAME "{" NEWLINE? (setting | environment)* "}" END
setting        ::= setting_name (STRING | NAME) END
                 | "redirect" STRING STRING END
setting_name   ::= "domain" | "firebase" | "region" | "ui" | "authentication" | "icon" | "serve"
                 | "title" | "one" | "analytics"

/* A place the project runs: its own domain, Firebase project and region, which take
 * the place of the shared ones. `one build --for staging` builds for it. */
environment    ::= "environment" NAME "{" NEWLINE? place* "}" END
place          ::= ("domain" | "firebase" | "region") STRING END

/* namespace */

namespace      ::= "namespace" NAME ("at" ROUTE)? "{" NEWLINE? declaration* "}" END

/* format */

format         ::= "format" NAME PATTERN ("{" NEWLINE? example* "}")? END
example        ::= "example" PATTERN END

/* entity */

entity         ::= "entity" NAME "history"? "{" NEWLINE? field* "}" END
field          ::= NAME (enum | type) rule* ("=" expression)? END
enum           ::= "enum" NAME STRING? ("|" NAME STRING?)*
type           ::= "text" | "markdown" | "email" | "slug" | "date" | "number" | serial | "boolean" | "user" | list | qualified
list           ::= "list" "of" ("text" | "user" | qualified)
serial         ::= "serial" ("per" NAME)?
rule           ::= "required" | "unique" | "key" | "after" NAME

/* backend */

backend        ::= "backend" NAME END

/* command */

command        ::= "command" qualified block? END
block          ::= "{" NEWLINE? statement* "}"
statement      ::= ( "require" expression STRING
                   | "permission" (permission_word | qualified)
                   | "clear" NAME+
                   | "return" expression
                   | if
                   | create
                   | "add" postfix "to" NAME
                   | "remove" postfix "from" NAME
                   | postfix "=" expression ) END
create         ::= "create" NAME "{" NEWLINE? ((NAME "=" postfix)+ END)* "}"
permission_word ::= "anyone" | "authenticated" | "owner"
if             ::= "if" expression block ("else" (if | block))?

/* view */

view           ::= "view" NAME ("per" NAME | "public")* "{" NEWLINE? ("readers" NAME END)? view_line* "}" END
view_line      ::= (NAME "=")? each
                 | "readers" NAME ("." NAME)+ END
                 | "public" "when" expression END
                 | NAME "=" expression END
each           ::= "each" ("change" "of")? postfix ("where" expression)? ("{" NEWLINE? list_line* "}")? END
list_line      ::= "order" order_key+ END
                 | "limit" WHOLE END
                 | row_line
order_key      ::= "-"? postfix
row_line       ::= (postfix+ | postfix* NAME "=" expression) END

/* role */

role           ::= "role" NAME ("per" NAME "from" NAME)? qualified*
                   ("{" NEWLINE? (qualified+ END)* "}")? END

/* function */

function       ::= "function" NAME "(" (NAME ("," NAME)*)? ")" block END

/* screen */

screen         ::= "screen" (STRING | NAME) ROUTE screen_block END
screen_block   ::= "{" NEWLINE? screen_item* "}"
screen_item    ::= ("hero" | "section") STRING ANCHOR? screen_block END
                 | "menu" screen_block END
                 | ("text" | "code" | "markdown") STRING END
                 | "link" (ROUTE | ANCHOR | "namespace" qualified | STRING) STRING END
                 | "table" qualified ("." NAME)? ("by" NAME)? ("link" ROUTE)? ("{" NEWLINE? (column+ END)* "}")? END
                 | "form" qualified+ STRING? "{" NEWLINE? form_line* "}" END
                 | "confirm" qualified STRING END
                 | ("thread" | "timeline") qualified "." NAME END
                 | "copy" qualified STRING? END
                 | "component" NAME END
                 | NAME ("::" NAME)+ STRING? ("when" expression)? END
column         ::= postfix STRING?
form_line      ::= ((NAME STRING?)+ | (NAME STRING?)* NAME STRING? "=" expression hint?) END
hint           ::= "{" NEWLINE? "hint" STRING END "}"

/* picker */

picker         ::= "picker" NAME "from" NAME END

/* webhook */

webhook        ::= "webhook" NAME ROUTE "{" NEWLINE? webhook_line* "}" END
webhook_line   ::= "for" NAME "by" NAME END
                 | "on" NAME block END

/* expressions, loosest first */

expression     ::= conjunction ("||" conjunction)*
conjunction    ::= equality ("&&" equality)*
equality       ::= comparison (("==" | "!=" | "has") comparison)*
comparison     ::= sum (("<" | ">" | "<=" | ">=") sum)*
sum            ::= product (("+" | "-") product)*
product        ::= unary ("*" unary)*
unary          ::= ("!" | "-") unary | postfix
postfix        ::= primary ("(" (argument ("," argument)*)? ")" | "." NAME)*
argument       ::= expression ("where" expression)?
primary        ::= STRING | NUMBER | built_in | qualified | "(" expression ")"
built_in       ::= "now" | "me" | "none" | "true" | "false"
qualified      ::= NAME ("::" NAME)*
