// uione's license, linked from every page's footer: what it covers, and the GNU AGPL's
// full text, from license/license.md, set as a document.

namespace license {

	screen "License" / {
		subtitle "uione is free software, licensed under the GNU Affero General Public License, version 3 only (AGPL-3.0-only): the compiler, the libraries apps are built on, the desktop and terminal toolkits, the tools, the examples and this site. You may use it, study it, change it and share it, and whoever you share it with gets the same freedoms."
		markdown "license/*.md" as document
	}

} // namespace license
