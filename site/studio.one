// A list of a person's projects, kept to prove sign-in, ownership and a private view
// end to end (tools/end-to-end.mjs). It has no screen: the studio itself runs at
// uione.io, from its own repository.

namespace studio {

	entity project {
		name   text  required
		owner  user  = me
	}

	command project::create {
		permission authenticated
	}

	// One document per person, readable only by that person. A screen that shows it
	// asks for sign-in by itself: nothing on the screen says so.
	view projects per user {
		each project where owner == user.id {
			name  created_at
		}
	}

} // namespace studio
