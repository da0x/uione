// The docs. Every markdown file in docs/ is a page, named by its file without the
// number: docs/02-language.md is /docs/language. The pages list themselves in file
// order, and the markdown becomes HTML when the site is built, not in the browser.

namespace docs {

	screen docs /:page {
		markdown "docs/*.md"
	}

} // namespace docs
