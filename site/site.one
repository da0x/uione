// uione.io: what uione is, a waitlist, the docs, and the start of the studio.
//
// This folder is one uione project. `one build site` turns it into site/build/web
// (React, yarn), site/build/api (Go), site/build/infrastructure (Pulumi) and the
// Firestore rules, and nothing in site/build is edited by hand.

import one

project uione {
	one        "0.7.7"
	domain     "www.uione.io"
	firebase   "uione-web"
	region     "us-east4"
	ui         radix
	icon       "assets/icon.svg"
	serve      "public"
}

footer {
	text "© {year} [Daher Alfawares](https://www.linkedin.com/in/daheralfawares)"
	link build.release "uione {build.version}"
	link build.source "{build.commit}"
}
