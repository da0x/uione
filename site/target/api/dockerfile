# Generated from site/ by one. Do not edit.
#
# Builds the backend. When its go.mod points the one library at a folder, the
# deploy puts that folder beside it, in one/, and the build uses it.
FROM golang:1.26 AS build
WORKDIR /src
COPY . .
WORKDIR /src/api
RUN if [ -d ../one ]; then go mod edit -replace github.com/da0x/uione/one=../one; fi \
    && go mod tidy && CGO_ENABLED=0 go build -o /backend .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /backend /backend
ENTRYPOINT ["/backend"]
