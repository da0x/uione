// The waitlist: anyone can join, and all anyone can see is how many have.

namespace waitlist {

	// The normalized address is the id, so joining twice is joining once.
	entity signup {
		email  email  required  key
	}

	command signup::create {
		by anyone
	}

	// Public, and a number only: never an address.
	view signups public {
		total = count(signup)
	}

} // namespace waitlist
