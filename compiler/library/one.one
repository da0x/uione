// uione's own library: what a project block may say, and the values it takes. A
// project's file says import one to use it. A value is written plainly when its type
// is known, like corners square, or in full, like corners one::corners::square.

namespace one {

	// The component set a site is drawn with.
	enum ui {
		radix  "Radix"
	}

	// A way people sign in, one to a line.
	enum signin {
		google     "Google"
		github     "GitHub"
		microsoft  "Microsoft"
	}

	// The site's look unless it says: a cool, exact palette, pages a breath off
	// white, panels white, a deep blue-black for text and one blue accent. Dark is
	// navy-black, not gray.
	define theme harbor "Harbor" {
		page     #f7f8fa  dark #0a101c
		surface  #ffffff  dark #111a2b
		sunken   #eef1f5  dark #0d1524
		ink      #0e1726  dark #e6ebf3
		muted    #5b6577  dark #94a0b4
		line     #dde2ea  dark #1f2a3d
		accent   #2457d6  dark #7ea6ff
		danger   #c2312d  dark #ff7b72
		success  #1a7f37  dark #3fb950
		warning  #9a6700  dark #d29922
		text     "IBM Plex Sans"
		code     "IBM Plex Mono"
		corners  10
		depth    raised
	}

	// PaperColor, the palette of the editor theme: a warm gray page, like paper, with
	// graphite text and its navy for what's pressed; dark, near black with soft blues.
	// Panels sit flat on the page.
	define theme papercolor "PaperColor" from harbor {
		page     #eeeeee  dark #1c1c1c
		surface  #f7f7f7  dark #262626
		sunken   #e4e4e4  dark #161616
		ink      #262626  dark #e4e4e4
		muted    #4e4e4e  dark #b2b2b2
		line     #d0d0d0  dark #3a3a3a
		accent   #005faf  dark #5fafd7
		danger   #af0000  dark #ff5f87
		success  #005f00  dark #5faf00
		warning  #875f00  dark #d7af5f
		depth    flat
	}

	// Whether a site opens light or dark: as the visitor's system is, unless it says.
	// A visitor's own pick, with the toggle at the top of every page, still wins.
	enum appearance {
		system  "As the system is"
		light   "Light"
		dark    "Dark"
	}

	// How screens are laid out unless one says: in one column, or in a wide main one
	// with a narrow side.
	enum layout {
		single       "One column"
		two_columns  "Two columns"
	}

	// What a site offers its readers besides light and dark: a menu of display
	// settings, each kept in the reader's browser: more contrast, larger text, more
	// space between lines and letters, a legible font, less motion, solid panels,
	// underlined links and a thicker focus ring. Whatever it says, a site follows a
	// reader's system when it asks for more contrast or less motion.
	enum accessibility {
		menu  "A menu of display settings"
	}

	// Counting the site's visitors, once each agrees to it.
	enum analytics {
		google  "Firebase Analytics"
	}

	// The colors a section or a filter is drawn in, section "Wiki" color violet, each
	// in the component set's own shade of it, light and dark. Without one, it's the
	// site's own color.
	enum hue {
		blue    "Blue"
		teal    "Teal"
		green   "Green"
		amber   "Amber"
		red     "Red"
		violet  "Violet"
	}

	// What a project says about itself: where it runs, how people sign in, and how it
	// looks. Each line is one of these, and only a list may be said more than once.
	settings project {
		// The uione it's built with, like "0.7.6", which one upgrade moves on.
		one         version
		// What the site is called, when it isn't the project's own name.
		title       text
		// Where it's served, like "neotrac.org".
		domain      domain
		// The Firebase project, and so the Google Cloud project, it runs in.
		firebase    slug
		// The Google Cloud region its backend runs in, like "us-east4".
		region      slug
		// The component set it's drawn with.
		ui          ui
		// The ways people sign in, one to a line.
		signin      list of signin
		// The site's icon: an SVG file beside the project's .one files.
		icon        file
		// How the site looks: a theme of its own, or uione's, like papercolor.
		theme       theme
		// Whether it opens light or dark, rather than as the visitor's system is.
		appearance  appearance
		// How screens are laid out unless one says.
		layout      layout
		// A folder of files served as they are, at the site's root.
		serve       folder
		// An address of the site that sends whoever asks for it somewhere else, one to
		// a line.
		redirect    list of redirect
		// Display settings for readers, beside light and dark.
		accessibility  accessibility
		// Counting the site's visitors, once each agrees to it.
		analytics   analytics
	}

	// What a place the project runs has of its own: environment staging { ... }.
	settings environment {
		// Where it's served.
		domain    domain
		// Its own Firebase project.
		firebase  slug
		// Its own region.
		region    slug
	}

	// redirect "/install.sh" "https://www.uione.io/install.sh"
	settings redirect {
		// An address of this site.
		from  address
		// Where whoever asks for it goes: an https address, or another of this site's.
		to    link
	}

} // namespace one
