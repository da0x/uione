// uione's own library: what a project block may say, and the values it takes. A
// project's file says import one to use it. A value is written plainly when its type
// is known, like corners square, or in full, like corners one::corners::square.

namespace one {

	// The component set a site is drawn with.
	enum ui {
		radix  "Radix"
	}

	// A way people sign in, one to a line.
	enum signin {
		google     "Google"
		github     "GitHub"
		microsoft  "Microsoft"
	}

	// The site's colors, light and dark, as a theme of its component set's; left out,
	// the component set's own.
	enum theme {
		papercolor  "PaperColor"
	}

	// How corners are drawn: square for a sharper look, or round, as they are unless
	// it says.
	enum corners {
		square  "Square"
		round   "Round"
	}

	// How screens are laid out unless one says: in one column, or in a wide main one
	// with a narrow side.
	enum layout {
		single       "One column"
		two_columns  "Two columns"
	}

	// Counting the site's visitors, once each agrees to it.
	enum analytics {
		google  "Firebase Analytics"
	}

	// What a project says about itself: where it runs, how people sign in, and how it
	// looks. Each line is one of these, and only a list may be said more than once.
	settings project {
		// The uione it's built with, like "0.7.0", which one upgrade moves on.
		one        version
		// What the site is called, when it isn't the project's own name.
		title      text
		// Where it's served, like "neotrac.org".
		domain     domain
		// The Firebase project, and so the Google Cloud project, it runs in.
		firebase   slug
		// The Google Cloud region its backend runs in, like "us-east4".
		region     slug
		// The component set it's drawn with.
		ui         ui
		// The ways people sign in, one to a line.
		signin     list of signin
		// The site's icon: an SVG file beside the project's .one files.
		icon       file
		// The site's own color for its buttons and links, as "#rrggbb", dark enough to
		// read on a white page.
		color      color
		// The site's colors, light and dark.
		theme      theme
		// How corners are drawn.
		corners    corners
		// How screens are laid out unless one says.
		layout     layout
		// A folder of files served as they are, at the site's root.
		serve      folder
		// An address of the site that sends whoever asks for it somewhere else, one to
		// a line.
		redirect   list of redirect
		// Counting the site's visitors, once each agrees to it.
		analytics  analytics
		// What's new to the person signed in, counted beside the site's name.
		unread     unread
		// Who the site is by, at the foot of every page, and where their name links.
		copyright  copyright
	}

	// What a place the project runs has of its own: environment staging { ... }.
	settings environment {
		// Where it's served.
		domain    domain
		// Its own Firebase project.
		firebase  slug
		// Its own region.
		region    slug
	}

	// redirect "/install.sh" "https://www.uione.io/install.sh"
	settings redirect {
		// An address of this site.
		from  address
		// Where whoever asks for it goes: an https address, or another of this site's.
		to    link
	}

	// copyright "Ada Lovelace" "https://www.linkedin.com/in/ada"
	settings copyright {
		// Who the site is by.
		name  text
		// Where their name links, when it does.
		link  link
	}

	// unread news.changes since news.seen
	settings unread {
		// A list of a view per user, whose rows are counted.
		list   view_list
		// A value of the same view: what came after it is new.
		since  view_value
	}

} // namespace one
