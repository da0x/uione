# The Firestore emulator a deploy starts the new backend on, with a copy of what the
# project stores, before deploying it, and the Authentication emulator, with no one
# signed up, for what the backend asks Firebase as it starts. Built from the official Node image, with Java
# from Debian, since the emulator runs on Java 21.

FROM node:22-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global firebase-tools@15.32.0

WORKDIR /emulators
COPY firebase.json .
RUN firebase setup:emulators:firestore

EXPOSE 8080 9099

# A demo- project never touches a real Firebase project.
CMD ["firebase", "emulators:start", "--project", "demo-rehearsal", "--only", "firestore,auth"]
