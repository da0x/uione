// A theme of a site's own, for the highlighting test: its colors are constants, and
// dark, ground, depth and a font's from are the language's words.

import one

define theme sea "Sea" from harbor {
	accent   #0b5cad  dark #8cc4ff
	text     "Inter"
	heading  "Fraunces" from "fonts/Fraunces.ttf"
	code     "IBM Plex Mono"  ground #f4f7fb  dark #0d1524
	corners  4
	depth    flat
}
