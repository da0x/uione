// A project that runs in two places, for the highlighting test.

project shop {
	region  "us-east4"
	ui      radix
	unread  news.changes since news.seen
	environment production {
		domain    "shop.example"
		firebase  "shop-production"
	}
	environment staging {
		domain    "staging.shop.example"
		firebase  "shop-staging"
	}
}

namespace shop {

	entity deploy {
		environment  text  required
	}

} // namespace shop
