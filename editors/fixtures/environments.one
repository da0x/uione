// A project that runs in two places, for the highlighting test.

import one

project shop {
	region  "us-east4"
	ui      radix
	corners one::corners::square
	environment production {
		domain    "shop.example"
		firebase  "shop-production"
	}
	environment staging {
		domain    "staging.shop.example"
		firebase  "shop-staging"
	}
}

header {
	badge news.unread
}

footer columns {
	section "Shop" {
		text "© {year} Shop Ltd"
		link build.release "uione {build.version}"
	}
}

namespace shop {

	entity deploy {
		environment  text  required
	}

} // namespace shop
