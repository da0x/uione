// Files, for the highlighting test: file is a type, alone or in a list.

namespace press {

	entity order {
		title     text  required
		proof     file
		pictures  list of file
	}

}

screen "Home" / landing constellation {
	hero "Fast." {
		overline "Print"
		text "Very."
	}
	section "Proofs" icon shield {
		text "Checked."
	}
	statement "Print that arrives on time."
	section "How" as steps {
		section "Send" {
			text "A file."
		}
	}
}
