// A command's body that takes an input and changes or deletes other entities, for
// the highlighting test: input and delete are keywords only where they start one.

namespace board {

	entity column {
		title     text
		position  number
	}

	entity arrow {
		from  column
		to    column
	}

	entity card {
		column  column
		input   text
	}

	command column::delete {
		input into column
		each card where column == id {
			column = into
		}
		delete each card where column == into
	}

	command column::update

	view columns {
		columns = each column {
			order by position
			title  position
		}
		arrows = each arrow {
			from  to
		}
	}

	screen "Columns" /columns {
		table columns.columns {
			reorder position
			title
			delete "Remove"
		}
		grid columns.arrows by from and to over columns.columns
	}

}
