// A command's body that takes an input and changes or deletes other entities, for
// the highlighting test: input and delete are keywords only where they start one.

namespace board {

	entity column {
		title     text
		notes     markdown  searchable
		position  number
		cover     file
	}

	entity arrow {
		from  column
		to    column
	}

	entity card {
		column  column
		input   text
		title   text
	}

	command card::update
	command card::delete

	command column::delete {
		input into column
		each card where column == id {
			dispatch card::update { column = into }
		}
		each card where column == into {
			dispatch card::delete
		}
	}

	command column::update

	// Moved a place along, coming round again after the fourth.
	command column::shift {
		position = (was position + 1) % 4
	}

	command card::move {
		changes column
	}

	view columns {
		columns = each column {
			order by position
			title  position
		}
		arrows = each arrow {
			from  to
		}
		cards = each card {
			column  title
		}
	}

	screen "Columns" /columns {
		heading {
			card::move "Move" icon edit
		}
		subtitle "The columns"
		find "Find a column" {
			columns.columns "Columns" by title notes
		}
		timeline columns.changes "What's new" {
			new when created_at > columns.seen
			on open dispatch glance::create
		}
		table columns.columns {
			picture cover fit
			reorder position
			hide when empty
			title
			delete "Remove"
		}
		grid columns.arrows by from and to over columns.columns
		diagram columns.arrows by from and to over columns.columns
		cards columns.columns {
			title
			tally columns.cards by column and column
			filter "Untitled" title == "x"
			filter "Recent" updated_at > 7 days ago  color green
		}
		board columns.cards by column over columns.columns {
			move card::move along columns.arrows
			title
		}
		collage columns.cards size width height {
			at left top  size across down
			stacked by position
			picture cover sized cover_width cover_height
			cropped to cx cy cw ch
			turned quarter_turns
			mirrored flipped
			around margin
			rounded roundness
			words title sized letters colored ink weighing boldness slanted lean
			paste
		}
	}

}
