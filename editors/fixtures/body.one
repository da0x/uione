// A command's body that takes an input and changes or deletes other entities, for
// the highlighting test: input and delete are keywords only where they start one.

namespace board {

	entity column {
		title     text
		position  number
	}

	entity arrow {
		from  column
		to    column
	}

	entity card {
		column  column
		input   text
		title   text
	}

	command column::delete {
		input into column
		each card where column == id {
			column = into
		}
		delete each card where column == into
	}

	command column::update

	command card::move {
		changes column
	}

	view columns {
		columns = each column {
			order by position
			title  position
		}
		arrows = each arrow {
			from  to
		}
		cards = each card {
			column  title
		}
	}

	screen "Columns" /columns {
		heading {
			card::move "Move" icon edit
		}
		subtitle "The columns"
		find "Find a column" {
			columns.columns "Columns" by title
		}
		timeline columns.changes "What's new" {
			new since columns.seen
			seen glance::create
		}
		table columns.columns {
			reorder position
			hide when empty
			title
			delete "Remove"
		}
		grid columns.arrows by from and to over columns.columns
		diagram columns.arrows by from and to over columns.columns
		cards columns.columns {
			title
			tally columns.cards by column and column
			filter "Untitled" title == "x"
			filter "Recent" updated_at > 7 days ago  color green
		}
		board columns.cards by column over columns.columns {
			move card::move along columns.arrows
			title
		}
	}

}
