// A role each project has its own of, for the highlighting test: each line names a
// command by the entity it's on, so project:: and member:: are names, not
// declarations.

namespace tracker {

	entity label {
		name  text  required
	}

	entity project {
		name    text           required
		tags    list of label
	}

	command project::create {
		by anyone signed in
	}
	command project::update
	command member::create

	define role maintainer "Maintainer" in project {
		project::update
		member::create
		page::update
		link::delete
	}

} // namespace tracker

namespace guild {
	entity hall {
		slug  text  required  key
	}

	entity seat {
		hall    hall  required  key
		person  user  required  key
	}

	entity invitation invites seat {
		hall   hall   required  key
		email  email  required  key
	}
}
