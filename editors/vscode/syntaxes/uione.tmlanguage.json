{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "uione",
  "scopeName": "source.uione",
  "fileTypes": [
    "one"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#project"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#routes"
    },
    {
      "include": "#example"
    },
    {
      "include": "#assigned"
    },
    {
      "include": "#member"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.uione",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        },
        {
          "name": "comment.block.uione",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "todo": {
      "match": "\\b(?:TODO|FIXME|XXX|NOTE)\\b",
      "name": "keyword.other.todo.uione"
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(format)\\s+([A-Za-z_]\\w*)(?:\\s+([^\\s{]+))?",
          "captures": {
            "1": {
              "name": "storage.type.uione"
            },
            "2": {
              "name": "entity.name.type.uione"
            },
            "3": {
              "name": "string.regexp.uione"
            }
          }
        },
        {
          "match": "^\\s*(namespace)\\b(?!::|\\s*=)(?:\\s+([A-Za-z_]\\w*))?",
          "captures": {
            "1": {
              "name": "storage.type.uione"
            },
            "2": {
              "name": "entity.name.namespace.uione"
            }
          }
        },
        {
          "match": "^\\s*(command|function)\\b(?!::|\\s*=)(?:\\s+((?:[A-Za-z_]\\w*::)*)([A-Za-z_]\\w*))?",
          "captures": {
            "1": {
              "name": "storage.type.uione"
            },
            "2": {
              "name": "entity.name.namespace.uione"
            },
            "3": {
              "name": "entity.name.function.uione"
            }
          }
        },
        {
          "match": "^\\s*(once)\\b(?=\\s+\")",
          "captures": {
            "1": {
              "name": "storage.type.uione"
            }
          }
        },
        {
          "match": "^\\s*(project|environment|enum|entity|view|roles|role|screen|picker|webhook|backend)\\b(?!::|\\s*=)(?:\\s+((?:[A-Za-z_]\\w*::)*)([A-Za-z_]\\w*))?",
          "captures": {
            "1": {
              "name": "storage.type.uione"
            },
            "2": {
              "name": "entity.name.namespace.uione"
            },
            "3": {
              "name": "entity.name.type.uione"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.uione",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.uione"
        },
        {
          "name": "meta.embedded.line.uione",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.uione"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.uione"
            }
          },
          "patterns": [
            {
              "include": "#namespaces"
            },
            {
              "include": "#calls"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "routes": {
      "patterns": [
        {
          "name": "string.other.path.uione",
          "begin": "(?<=^|\\s)/(?=[A-Za-z:]|[\\s{]|$)",
          "end": "(?=[\\s{]|$)",
          "patterns": [
            {
              "match": ":[A-Za-z_]\\w*",
              "name": "variable.parameter.uione"
            }
          ]
        },
        {
          "match": "(?<=^|\\s)#[A-Za-z_][\\w-]*",
          "name": "string.other.path.uione"
        }
      ]
    },
    "example": {
      "match": "\\b(example)\\s+(\\S.*?)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.other.uione"
        },
        "2": {
          "name": "string.unquoted.uione"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "comment": "each change of issue: change is the language's own record of an entity's changes, a type, as text is.",
          "match": "\\b(change)\\s+(of)\\b",
          "captures": {
            "1": {
              "name": "support.type.uione"
            },
            "2": {
              "name": "keyword.other.uione"
            }
          }
        },
        {
          "begin": "\\b(link)\\s+(namespace)\\b",
          "end": "(?=\")|$",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.uione"
            },
            "2": {
              "name": "keyword.other.uione"
            }
          },
          "patterns": [
            {
              "match": "::",
              "name": "punctuation.separator.namespace.uione"
            },
            {
              "match": "[A-Za-z_]\\w*",
              "name": "entity.name.namespace.uione"
            }
          ]
        },
        {
          "match": "\\b(permission)\\s+(anyone|signed_in|owner)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.uione"
            },
            "2": {
              "name": "constant.language.uione"
            }
          }
        },
        {
          "match": "\\b(?:if|else|return)\\b",
          "name": "keyword.control.uione"
        },
        {
          "match": "^\\s*(input)(?=\\s+[A-Za-z_]\\w*\\s+[A-Za-z_])",
          "captures": {
            "1": {
              "name": "keyword.other.uione"
            }
          }
        },
        {
          "match": "^\\s*(delete)(?=\\s+each\\b)",
          "captures": {
            "1": {
              "name": "keyword.other.uione"
            }
          }
        },
        {
          "match": "^\\s*(move)(?=\\s+[A-Za-z_]\\w*::)",
          "captures": {
            "1": {
              "name": "keyword.other.uione"
            }
          }
        },
        {
          "match": "^\\s*(changes)(?=\\s+[A-Za-z_])",
          "captures": {
            "1": {
              "name": "keyword.other.uione"
            }
          }
        },
        {
          "match": "\\b(?:text|code)(?=\\s+\")",
          "name": "keyword.other.uione"
        },
        {
          "match": "(?<!::)(?<!\\.)\\b(?:require|permission|clear|create|readers|when|was|add|remove|to|has|of|limit|for|by|on|component|order|each|per|where|from|table|form|confirm|hint|hero|section|menu|thread|timeline|copy|details|grid|diagram|board|under|cards|tally|filter|subtitle|icon|hide|empty|along|over|and|reorder|heading|layout|main|side|search|sort|ascending|descending|page|link|markdown|at|ago|hour|hours|day|days|week|weeks)\\b",
          "name": "keyword.other.uione"
        },
        {
          "match": "(?<!::)(?<!\\|)(?<!\\| )(?<!enum )\\b(?:public)\\b(?=\\s*(?:\\{|$|when\\b))",
          "name": "storage.modifier.uione"
        },
        {
          "match": "^\\s*(?!(?:sort|order|search|page|by)\\s)[A-Za-z_]\\w*\\s+(text|markdown|email|slug|date|number|serial|boolean|user|list|enum)\\b",
          "captures": {
            "1": {
              "name": "support.type.uione"
            }
          }
        }
      ]
    },
    "calls": {
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()",
      "name": "entity.name.function.call.uione"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:now|me|none|true|false)\\b",
          "name": "constant.language.uione"
        },
        {
          "match": "\\b[A-Z]\\w*\\b",
          "name": "constant.other.uione"
        }
      ]
    },
    "numbers": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.uione"
    },
    "operators": {
      "match": "==|!=|<=|>=|&&|\\|\\||[-+*<>=!|]",
      "name": "keyword.operator.uione"
    },
    "namespaces": {
      "patterns": [
        {
          "match": "\\b[A-Za-z_]\\w*(?=::)",
          "name": "entity.name.namespace.uione"
        },
        {
          "match": "::",
          "name": "punctuation.separator.namespace.uione"
        }
      ]
    },
    "entity": {
      "comment": "An entity's block: each line is a field, its name first, then its type, built in or another entity, so `project  project  required  key` is a field named project holding a project. Inside it, words that start declarations elsewhere are names.",
      "begin": "^\\s*(entity)\\s+([A-Za-z_]\\w*)(?:\\s+(history))?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.uione"
        },
        "2": {
          "name": "entity.name.type.uione"
        },
        "3": {
          "name": "keyword.other.uione"
        }
      },
      "end": "^\\s*(\\})",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "comment": "A list's type is one type, read as a unit: list of text, list of label.",
          "match": "^\\s*([A-Za-z_]\\w*)\\s+(list)\\s+(of)\\s+(?:(text|markdown|email|slug|date|number|serial|boolean|user|permission)\\b|([A-Za-z_]\\w*(?:::[A-Za-z_]\\w*)*))",
          "captures": {
            "1": {
              "name": "variable.other.field.uione"
            },
            "2": {
              "name": "support.type.uione"
            },
            "3": {
              "name": "support.type.uione"
            },
            "4": {
              "name": "support.type.uione"
            },
            "5": {
              "name": "support.type.user.uione"
            }
          }
        },
        {
          "match": "^\\s*(?!(?:sort|order|search|page|by)\\s)([A-Za-z_]\\w*)\\s+(?:(text|markdown|email|slug|date|number|serial|boolean|user|list|enum)\\b|([A-Za-z_]\\w*(?:::[A-Za-z_]\\w*)*))",
          "captures": {
            "1": {
              "name": "variable.other.field.uione"
            },
            "2": {
              "name": "support.type.uione"
            },
            "3": {
              "name": "support.type.user.uione"
            }
          }
        },
        {
          "match": "\\b(?:per|of)\\b",
          "name": "keyword.other.uione"
        },
        {
          "match": "\\b(?:required|unique|after|key)\\b",
          "name": "storage.modifier.uione"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "assigned": {
      "comment": "A name given a value with =, like title = issue.title in a view or status = status::closed in a command: the field it sets.",
      "match": "(?<![.\\w])([a-z_]\\w*)\\s*(=)(?!=)",
      "captures": {
        "1": {
          "name": "variable.other.field.uione"
        },
        "2": {
          "name": "keyword.operator.uione"
        }
      }
    },
    "member": {
      "comment": "What follows a dot is a field of what's before it, like title in issue.title, even a word that's a keyword elsewhere.",
      "match": "(?<=\\w\\.)[a-z_]\\w*"
    },
    "project": {
      "comment": "A project's block: its settings, each a word at the start of its line, and its environments, whose blocks hold settings too. Elsewhere those words are names, like a column called title.",
      "begin": "^\\s*(project)\\s+([A-Za-z_]\\w*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.uione"
        },
        "2": {
          "name": "entity.name.type.uione"
        }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#project-body"
        }
      ]
    },
    "project-body": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "match": "^\\s*(domain|firebase|region|ui|signin|icon|color|theme|corners|layout|serve|redirect|title|one|analytics)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.uione"
            }
          }
        },
        {
          "include": "#declarations"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#project-body"
            }
          ]
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        }
      ]
    }
  }
}
