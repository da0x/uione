# Runs one::client's tests against a real app: the tasks example's backend, as
# tools/build-backends built it, serving on the Firebase emulators
# (tools/emulators/run starts them), with its rules loaded.
#
#   client/tests/run build/native/client/tests

set -eu
root=$(cd "$(dirname "$0")/../.." && pwd)
tests=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
api=$root/examples/tasks/build/api/server
[ -x "$api" ] || { echo "client/tests/run: run one build examples/tasks and tools/build-backends first" >&2; exit 1; }
work=$(mktemp -d)
server=
trap '[ -n "$server" ] && kill "$server" 2>/dev/null; rm -rf "$work"' EXIT

node "$root/tools/emulators/rules.mjs" "$root/examples/tasks/build/firestore.rules" >/dev/null
PORT=8097 FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 "$api" >"$work/api.log" 2>&1 &
server=$!
for i in $(seq 1 100); do
	curl -s -o /dev/null http://localhost:8097/health && break
	sleep 0.1
done
ONE_CLIENT_SERVER=http://localhost:8097 XDG_CONFIG_HOME="$work/config" "$tests" || { tail -20 "$work/api.log"; exit 1; }
